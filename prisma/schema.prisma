/// FIFA FRIENDS CUP - data contract
/// This file is auto-generated by Prisma and does NOT support runtime logic (constructors, etc.)
/// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TournamentStatus {
  SETUP
  DRAWING
  GROUP_STAGE
  KNOCKOUT
  FINISHED
}

enum MatchStage {
  GROUP
  ROUND_OF_16
  QUARTERFINAL
  SEMIFINAL
  FINAL
  THIRD_PLACE
}

enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

enum MatchSlotType {
  GROUP_DIRECT
  GROUP_POSITION
  WINNER
  LOSER
}

enum SlotPosition {
  HOME
  AWAY
}

/// Tournament
/// Representa un torneo completo.
model Tournament {
  id           String           @id @default(uuid())
  name         String
  description  String?
  status       TournamentStatus @default(SETUP)
  drawRunCount Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  pairs   Pair[]
  groups  Group[]
  matches Match[]
}

/// Participant
/// Representa una persona que participa en el torneo.
/// No pertenece a un torneo concreto: se reutiliza en múltiples torneos a través de Pair.
model Participant {
  id        String    @id @default(uuid())
  name      String
  nickname  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  pairsAsFirst  Pair[] @relation("PairParticipant1")
  pairsAsSecond Pair[] @relation("PairParticipant2")
}

/// Team
/// Representa un equipo de fútbol disponible para el torneo.
/// No pertenece a un torneo concreto: se reutiliza en múltiples torneos a través de Pair.
model Team {
  id        String   @id @default(uuid())
  name      String
  shortName String?
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pairs Pair[]
}

/// Pair
/// Representa una pareja formada para un torneo.
/// - participants obligatorios; el equipo se asigna durante el DRAWING.
/// - El grupo se asigna durante el sorteo.
/// - Validación en la app: el mismo participante no puede aparecer dos veces en la misma pareja.
model Pair {
  id                 String   @id @default(uuid())
  tournamentId       String
  tournament         Tournament @relation(fields: [tournamentId], references: [id])

  participant1Id     String
  participant1       Participant @relation("PairParticipant1", fields: [participant1Id], references: [id])
  participant2Id     String
  participant2       Participant @relation("PairParticipant2", fields: [participant2Id], references: [id])

  teamId             String?
  team               Team?  @relation(fields: [teamId], references: [id])

  groupId            String?
  group              Group? @relation(fields: [groupId], references: [id])

  directSlots        MatchSlot[]

  @@unique([tournamentId, participant1Id, participant2Id], name: "unique_pair_participants")
  @@index([teamId])
  @@index([groupId])
}

/// Group
/// Representa un grupo del torneo (A, B, C, etc.).
model Group {
  id           String   @id @default(uuid())
  name         String
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])

  pairs      Pair[]
  matches    Match[]
  sourceSlots MatchSlot[]

  @@unique([tournamentId, name], name: "unique_group_name_per_tournament")
}

/// MatchSlot
/// Fuente de verdad de quién ocupa HOME/AWAY en un partido.
/// Cada Match tiene exactamente un slot HOME y un slot AWAY.
model MatchSlot {
  id          String       @id @default(uuid())

  matchId     String
  match       Match        @relation(fields: [matchId], references: [id])
  position    SlotPosition

  type        MatchSlotType

  directPairId String?
  directPair   Pair?      @relation(fields: [directPairId], references: [id])

  sourceGroupId String?
  sourceGroup   Group?    @relation(fields: [sourceGroupId], references: [id])
  sourcePosition Int?

  sourceMatchId String?
  sourceMatch   Match?    @relation("MatchSlotSource", fields: [sourceMatchId], references: [id])

  @@unique([matchId, position])
  @@index([sourceMatchId])
  @@index([sourceGroupId])
  @@index([directPairId])
}

/// Match
/// Representa cualquier partido del torneo.
/// HOME/AWAY no se guardan aquí: los define MatchSlot.
model Match {
  id           String      @id @default(uuid())
  tournamentId String
  tournament   Tournament  @relation(fields: [tournamentId], references: [id])

  groupId      String?
  group        Group?      @relation(fields: [groupId], references: [id])

  stage        MatchStage
  status       MatchStatus @default(SCHEDULED)

  homeGoals    Int         @default(0)
  awayGoals    Int         @default(0)
  penaltiesHomeGoals Int?
  penaltiesAwayGoals Int?

  playedAt     DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  slots             MatchSlot[]
  sourceMatchSlots  MatchSlot[] @relation("MatchSlotSource")

  @@index([tournamentId, stage])
  @@index([tournamentId, status])
  @@index([groupId])
}